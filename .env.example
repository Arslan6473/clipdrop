# Public site URL, used for canonical URLs, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://clipdrop.example

# Optional. Meta app access token for the oEmbed Read API. Enables Instagram and
# Facebook metadata (Meta offers no download mechanism, so no downloads either way).
META_OEMBED_ACCESS_TOKEN=

# Optional. The ClipDrop downloader API (downloader-api/, e.g. on Railway). When set, platform
# links (YouTube, TikTok, Instagram, Facebook) get real download formats.
DOWNLOADER_API_URL=
# Must match API_KEY on the downloader API. Server-side only; never exposed to browsers.
DOWNLOADER_API_KEY=
